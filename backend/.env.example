# Etaernal Backend — Environment Configuration Template
# Copy this file to .env and fill in values for local development.
# For Cloud PaaS (Render, Railway, Cloud Run), set these in the platform dashboard.
# NEVER commit .env with real credentials to version control.

# ==============================================================================
# SUPABASE (Optional for Demo Mode — Defaults to in-memory Mock Client)
# ==============================================================================

# Supabase Project API URL (If containing "demo", automatically uses in-memory mock data)
SUPABASE_URL=https://demo-project.supabase.co

# Supabase Anon (public) key
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service role key (Backend server only — NEVER expose to clients)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

APP_ENV=development
APP_HOST=0.0.0.0
# Cloud PaaS will automatically inject PORT; for local use APP_PORT or PORT
PORT=8000
DEBUG=true

# Allowed CORS origins — supports JSON array or comma-separated list
# Example for production: ["https://equinox01.vercel.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]


# Optional authenticated live railway provider (server only)
RAILRADAR_API_KEY=
# Optional ordered pool. When non-empty, replaces the single-key setting above.
# Configure only keys/allocations you are authorized to pool; never commit real keys.
RAILRADAR_API_KEYS=[]
RAILRADAR_LIVE_CACHE_SECONDS=120
# Retry an explicitly exhausted allocation after the provider Retry-After,
# or this conservative fallback if the provider gives no reset time.
RAILRADAR_QUOTA_COOLDOWN_SECONDS=86400
# Local SQLite cache and hashed credential cooldowns (no raw keys).
RAILRADAR_CACHE_PATH=data/railradar-cache.sqlite3

# OpenWeather 5-day / 3-hour forecast, backend only
WEATHER_API_KEY=

# Checked-in trained three-train ETA pilot; no training runtime is required.
ETA_ML_ENABLED=true
ETA_MODEL_PATH=data/eta_ml/model.json
# Sanitized observations from already-required provider fetches.
# Use durable hosting storage before relying on this archive across redeploys.
ETA_HISTORY_PATH=data/eta-observations.sqlite3
# Unverified passenger reports; SQLite on an ephemeral filesystem is not durable.
ETA_FEEDBACK_PATH=data/eta-feedback.sqlite3
