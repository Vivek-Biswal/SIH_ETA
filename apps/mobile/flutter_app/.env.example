# SIH_ETA Flutter Mobile App — Backend Configuration Guide
# Flutter supports build-time environment defines using --dart-define.

# ─────────────────────────────────────────────────────────────────────────────
# OPTION 1: Single Root Base URL (Recommended for V1)
# ─────────────────────────────────────────────────────────────────────────────
# Android Emulator (points to host PC localhost:8000):
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000
#
# iOS Simulator / Web / Desktop:
# flutter run --dart-define=API_BASE_URL=http://localhost:8000
#
# Production Cloud Backend (Release APK):
# flutter build apk --release --dart-define=API_BASE_URL=https://sih-eta-api.onrender.com

# ─────────────────────────────────────────────────────────────────────────────
# OPTION 2: Explicit Endpoint Overrides
# ─────────────────────────────────────────────────────────────────────────────
# API_URL=http://localhost:8000/api
# API_URL_V1=http://localhost:8000/api/v1
