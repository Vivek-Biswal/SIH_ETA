# Documentation only: Flutter does not load this file at runtime.
# Pass build-time defines, without private provider keys.
# Android emulator -> local API on the development computer:
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000
# iOS simulator / browser:
# flutter run --dart-define=API_BASE_URL=http://localhost:8000
# Public backend, release APK:
# flutter build apk --release --dart-define=API_BASE_URL=https://sih-eta-backend-a819.onrender.com
# Optional shared Journey insights origin (HTTPS only):
# --dart-define=JOURNEY_WEB_BASE_URL=https://equinox01.vercel.app
# Advanced overrides: API_URL (legacy /api), API_URL_V1 (versioned /api/v1).
