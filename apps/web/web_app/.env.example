# SIH_ETA Next.js Web App — Environment Configuration Template
# Copy this file to .env.local for local development.
# For Vercel or cloud deployment, configure these in the platform project settings.

# Backend API base URL (Must point to the /api/v1 prefix of the FastAPI backend)
# Production / shared backend:
NEXT_PUBLIC_API_BASE_URL=https://sih-eta-backend-a819.onrender.com/api/v1
# Local backend override:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket URL for real-time delay telemetry stream
# Local development only:
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# The passenger dashboard uses REST data and does not require this socket.
