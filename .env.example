# SIH_ETA — Environment Configuration Example
# Copy this file to .env in each subsystem and fill in real values.
# NEVER commit .env files with real credentials.

# ==============================================================================
# BACKEND — FastAPI
# ==============================================================================

# Application
APP_ENV=development                        # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-this-to-a-random-secret-key-in-production
DEBUG=true

# Supabase (PostgreSQL + Auth + Realtime)
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Authentication
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# INTELLIGENCE SERVICE
# ==============================================================================

# Model artifact storage (local path or S3-compatible URL)
MODEL_REGISTRY_PATH=./intelligence/models/saved
# MODEL_REGISTRY_PATH=s3://your-bucket/models/

# MLflow tracking (optional, for experiment tracking)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=sih_eta_train_prediction

# Feature store / data paths
PROCESSED_DATA_PATH=./data/processed
RAW_DATA_PATH=./data/raw

# ==============================================================================
# EXTERNAL DATA SOURCES (Indian Railways APIs)
# ==============================================================================

# NTES (National Train Enquiry System) API
NTES_API_URL=https://enquiry.indianrail.gov.in/api
NTES_API_KEY=your-ntes-api-key-here

# Optional: RailSaarthi / IRCTC API credentials
IRCTC_API_KEY=your-irctc-api-key-here

# Optional: Weather API (for delay factor enrichment)
WEATHER_API_URL=https://api.openweathermap.org/data/2.5
WEATHER_API_KEY=your-openweathermap-key-here

# ==============================================================================
# MOBILE APP — Flutter (place in apps/mobile/flutter_app/.env or dart-define)
# ==============================================================================

# API base URL for the mobile app to connect to backend
FLUTTER_API_BASE_URL=http://localhost:8000/api/v1
FLUTTER_WS_URL=ws://localhost:8000/ws

# ==============================================================================
# WEB APP — Next.js (place in apps/web/web_app/.env.local)
# ==============================================================================

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=SIH ETA Dashboard
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here    # for network map visualization

# ==============================================================================
# CI/CD (GitHub Actions secrets — set in repo settings, not here)
# ==============================================================================
# DOCKER_USERNAME
# DOCKER_PASSWORD
# STAGING_SERVER_SSH_KEY
# PRODUCTION_DB_URL
