# =============================================================================
# SIH_ETA — Root .gitignore
# Covers: Python/FastAPI backend, Flutter mobile, Next.js web, ML/AI, CI/CD
# =============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# SECRETS & ENVIRONMENT — NEVER COMMIT
# ──────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials/

# ──────────────────────────────────────────────────────────────────────────────
# PYTHON (Backend + Intelligence)
# ──────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
dist/
*.egg-info/
.eggs/
.cache/
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.tox/
pip-log.txt
pip-delete-this-directory.txt
.pdm.toml
.pdm-python
__pypackages__/

# Jupyter Notebooks
.ipynb_checkpoints
*.ipynb_checkpoints/

# ──────────────────────────────────────────────────────────────────────────────
# ML / INTELLIGENCE
# ──────────────────────────────────────────────────────────────────────────────
# Large model weights — use DVC or model registry instead
*.pkl
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.bin
*.safetensors
intelligence/models/checkpoints/
intelligence/train_eta/models/saved/
intelligence/network_intelligence/models/saved/
mlruns/
mlflow.db
wandb/
.neptune/

# Large raw data — managed separately (DVC / object storage)
data/raw/
data/processed/
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/sample/

# ──────────────────────────────────────────────────────────────────────────────
# FLUTTER / DART (Mobile App)
# ──────────────────────────────────────────────────────────────────────────────
apps/mobile/flutter_app/.dart_tool/
apps/mobile/flutter_app/.flutter-plugins
apps/mobile/flutter_app/.flutter-plugins-dependencies
apps/mobile/flutter_app/.packages
apps/mobile/flutter_app/.pub-cache/
apps/mobile/flutter_app/.pub/
apps/mobile/flutter_app/build/
apps/mobile/flutter_app/*.g.dart
apps/mobile/flutter_app/generated_plugin_registrant.dart
apps/mobile/flutter_app/android/.gradle/
apps/mobile/flutter_app/android/local.properties
apps/mobile/flutter_app/android/key.properties
apps/mobile/flutter_app/ios/.symlinks/
apps/mobile/flutter_app/ios/Pods/
apps/mobile/flutter_app/ios/Flutter/flutter_export_environment.sh
apps/mobile/flutter_app/ios/Flutter/App.framework
apps/mobile/flutter_app/ios/Flutter/Flutter.framework
apps/mobile/flutter_app/ios/Flutter/Generated.xcconfig
apps/mobile/flutter_app/ios/Runner/GeneratedPluginRegistrant.*
apps/mobile/flutter_app/coverage/

# ──────────────────────────────────────────────────────────────────────────────
# NODE.JS / NEXT.JS (Web App)
# ──────────────────────────────────────────────────────────────────────────────
apps/web/web_app/node_modules/
apps/web/web_app/.next/
apps/web/web_app/out/
apps/web/web_app/dist/
apps/web/web_app/.cache/
apps/web/web_app/npm-debug.log*
apps/web/web_app/yarn-debug.log*
apps/web/web_app/yarn-error.log*
apps/web/web_app/.pnpm-debug.log*

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
postgres-data/

# ──────────────────────────────────────────────────────────────────────────────
# OS & EDITOR
# ──────────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath

# ──────────────────────────────────────────────────────────────────────────────
# LOGS & TEMPORARY FILES
# ──────────────────────────────────────────────────────────────────────────────
*.log
logs/
tmp/
temp/

# ──────────────────────────────────────────────────────────────────────────────
# DOCKER (if added later)
# ──────────────────────────────────────────────────────────────────────────────
# docker-compose.override.yml   # Uncomment if needed
